# Burst: six requests arrive together and max_batch (4) is the only limit.
# FCFS admits the first four; each finished request frees a slot for the next in line.
policy fcfs
limits max_batch=4 total_pages=64 page_size=16
arrive step=0 id=a prompt=12 max_new=3
arrive step=0 id=b prompt=40 max_new=5
arrive step=0 id=c prompt=8 max_new=2
arrive step=0 id=d prompt=20 max_new=4
arrive step=0 id=e prompt=16 max_new=6
arrive step=0 id=f prompt=30 max_new=1
--- expected
step 0 queued=[a b c d e f] running=[] preempt=[] admit=[a b c d] finished=[] tokens=80+0 free_pages=57
step 1 queued=[e f] running=[a b c d] preempt=[] admit=[] finished=[c] tokens=0+4 free_pages=58
step 2 queued=[e f] running=[a b d] preempt=[] admit=[e] finished=[a] tokens=16+3 free_pages=58
step 3 queued=[f] running=[b d e] preempt=[] admit=[f] finished=[f d] tokens=30+3 free_pages=59
step 4 queued=[] running=[b e] preempt=[] admit=[] finished=[b] tokens=0+2 free_pages=62
step 5 queued=[] running=[e] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=62
step 6 queued=[] running=[e] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=62
step 7 queued=[] running=[e] preempt=[] admit=[] finished=[e] tokens=0+1 free_pages=64
