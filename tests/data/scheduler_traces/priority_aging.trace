# Starvation bound of the priority policy (aging_ms=40; one simulated step is 10 ms). The low-
# priority request arrives together with a stream of urgent ones that keeps the single slot busy.
# Every 40 ms of waiting raises it one level: at step 8 (80 ms) it is high priority too, and ahead
# of every urgent request still queued, because it arrived first. Without aging it would wait for
# the whole stream.
policy priority aging_ms=40
limits max_batch=1 total_pages=64 page_size=16 max_batch_tokens=64
arrive step=0 id=low prompt=4 max_new=2 priority=0
arrive step=0 id=h0 prompt=4 max_new=2 priority=2
arrive step=1 id=h1 prompt=4 max_new=2 priority=2
arrive step=2 id=h2 prompt=4 max_new=2 priority=2
arrive step=3 id=h3 prompt=4 max_new=2 priority=2
arrive step=4 id=h4 prompt=4 max_new=2 priority=2
arrive step=5 id=h5 prompt=4 max_new=2 priority=2
arrive step=6 id=h6 prompt=4 max_new=2 priority=2
arrive step=7 id=h7 prompt=4 max_new=2 priority=2
