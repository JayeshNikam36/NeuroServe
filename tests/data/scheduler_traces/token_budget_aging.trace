# Starvation bound of the token-budget policy (max_wait_steps=3). b (58 tokens) arrives while seven
# short requests are decoding, so it only fits once at most 6 requests are running. Short requests
# that arrive after b fit, and are admitted ahead of it, but only until b has waited 3 steps: then
# b is "aged", nobody may overtake it any more, the batch drains, and b starts.
policy token-budget max_wait_steps=3
limits max_batch=16 total_pages=64 page_size=16 max_batch_tokens=64
arrive step=0 id=s1 prompt=4 max_new=6
arrive step=0 id=s2 prompt=4 max_new=6
arrive step=0 id=s3 prompt=4 max_new=6
arrive step=0 id=s4 prompt=4 max_new=6
arrive step=0 id=s5 prompt=4 max_new=6
arrive step=0 id=s6 prompt=4 max_new=6
arrive step=0 id=s7 prompt=4 max_new=6
arrive step=1 id=b prompt=58 max_new=2
arrive step=1 id=t1 prompt=4 max_new=6
arrive step=2 id=t2 prompt=4 max_new=6
arrive step=3 id=t3 prompt=4 max_new=6
arrive step=4 id=t4 prompt=4 max_new=6
arrive step=5 id=t5 prompt=4 max_new=6
