# Priority-aware preemption (aging off). a and the low-priority l start first; the high-priority h
# joins at step 1. At step 6 the batch cannot grow: FCFS would preempt the newest request (h); the
# priority policy preempts the lowest priority instead (l). l restarts at step 7, is preempted
# again at step 9 (still the lowest priority), and finishes alone after a and h: the low-priority
# request pays for the memory pressure.
policy priority aging_ms=100000
limits max_batch=3 total_pages=8 page_size=4 max_batch_tokens=64
arrive step=0 id=a prompt=4 max_new=12
arrive step=0 id=l prompt=4 max_new=12 priority=0
arrive step=1 id=h prompt=4 max_new=12 priority=2
--- expected
step 0 queued=[a l] running=[] preempt=[] admit=[a l] finished=[] tokens=8+0 free_pages=6
step 1 queued=[h] running=[a l] preempt=[] admit=[h] finished=[] tokens=4+2 free_pages=3
step 2 queued=[] running=[a l h] preempt=[] admit=[] finished=[] tokens=0+3 free_pages=2
step 3 queued=[] running=[a l h] preempt=[] admit=[] finished=[] tokens=0+3 free_pages=2
step 4 queued=[] running=[a l h] preempt=[] admit=[] finished=[] tokens=0+3 free_pages=2
step 5 queued=[] running=[a l h] preempt=[] admit=[] finished=[] tokens=0+3 free_pages=0
step 6 queued=[] running=[a l h] preempt=[l] admit=[] finished=[] tokens=0+2 free_pages=2
step 7 queued=[l] running=[a h] preempt=[] admit=[l] finished=[] tokens=4+2 free_pages=1
step 8 queued=[] running=[a h l] preempt=[] admit=[] finished=[] tokens=0+3 free_pages=0
step 9 queued=[] running=[a h l] preempt=[l] admit=[] finished=[] tokens=0+2 free_pages=1
step 10 queued=[l] running=[a h] preempt=[] admit=[] finished=[] tokens=0+2 free_pages=0
step 11 queued=[l] running=[a h] preempt=[] admit=[] finished=[a] tokens=0+2 free_pages=4
step 12 queued=[l] running=[h] preempt=[] admit=[l] finished=[h] tokens=4+1 free_pages=7
step 13 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=6
step 14 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=6
step 15 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=6
step 16 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=6
step 17 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=5
step 18 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=5
step 19 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=5
step 20 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=5
step 21 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=4
step 22 queued=[] running=[l] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=4
step 23 queued=[] running=[l] preempt=[] admit=[] finished=[l] tokens=0+1 free_pages=8
