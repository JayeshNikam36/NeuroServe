# Decode-first: while a is decoding, a step's prefills are capped at 64 / 4 = 16 tokens, so the
# 30-token b waits until a finishes (FCFS would prefill it in step 1, making that step slower for
# a), and c waits behind b in arrival order. Running requests decode at an even pace; new
# requests start later.
policy decode-first
limits max_batch=8 total_pages=64 page_size=16 max_batch_tokens=64
arrive step=0 id=a prompt=10 max_new=5
arrive step=1 id=b prompt=30 max_new=3
arrive step=1 id=c prompt=8 max_new=2
--- expected
step 0 queued=[a] running=[] preempt=[] admit=[a] finished=[] tokens=10+0 free_pages=63
step 1 queued=[b c] running=[a] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=63
step 2 queued=[b c] running=[a] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=63
step 3 queued=[b c] running=[a] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=63
step 4 queued=[b c] running=[a] preempt=[] admit=[] finished=[a] tokens=0+1 free_pages=64
step 5 queued=[b c] running=[] preempt=[] admit=[b c] finished=[] tokens=38+0 free_pages=61
step 6 queued=[] running=[b c] preempt=[] admit=[] finished=[c] tokens=0+2 free_pages=62
step 7 queued=[] running=[b] preempt=[] admit=[] finished=[b] tokens=0+1 free_pages=64
