# KV-bound with head-of-line blocking: 10 pages in total. a needs 3, the large b needs 10, the
# small c needs 2. After a is admitted only 7 pages are free, so b must wait, and FCFS also makes
# c wait behind b even though c would fit. That idle capacity is what later policies trade
# against fairness.
policy fcfs
limits max_batch=8 total_pages=10 page_size=16
arrive step=0 id=a prompt=30 max_new=4
arrive step=0 id=b prompt=150 max_new=6
arrive step=0 id=c prompt=16 max_new=4
--- expected
step 0 queued=[a b c] running=[] preempt=[] admit=[a] finished=[] tokens=30+0 free_pages=8
step 1 queued=[b c] running=[a] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=8
step 2 queued=[b c] running=[a] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=8
step 3 queued=[b c] running=[a] preempt=[] admit=[] finished=[a] tokens=0+1 free_pages=10
step 4 queued=[b c] running=[] preempt=[] admit=[b] finished=[] tokens=150+0 free_pages=0
step 5 queued=[c] running=[b] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=0
step 6 queued=[c] running=[b] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=0
step 7 queued=[c] running=[b] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=0
step 8 queued=[c] running=[b] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=0
step 9 queued=[c] running=[b] preempt=[] admit=[] finished=[b] tokens=0+1 free_pages=10
step 10 queued=[c] running=[] preempt=[] admit=[c] finished=[] tokens=16+0 free_pages=9
step 11 queued=[] running=[c] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=8
step 12 queued=[] running=[c] preempt=[] admit=[] finished=[] tokens=0+1 free_pages=8
step 13 queued=[] running=[c] preempt=[] admit=[] finished=[c] tokens=0+1 free_pages=10
